{
  "context_servers": {
    "atlas": {
      "enabled": true,
      "remote": false,
      "command": "atlas",
      "args": [
        "--repo",
        "/home/pastel/Projects/atlas-context-router-rs",
        "serve",
        "--direct-stdio",
      ],
      "env": {},
    },
  },
  "context_server_timeout": 60,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/tests/fixtures/**"
  ]
}
