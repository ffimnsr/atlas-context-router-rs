{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-context-router-rs/schemas/atlas_cli.v1/review-context.schema.json",
  "title": "atlas_cli.v1 review_context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "data"],
  "properties": {
    "schema_version": { "const": "atlas_cli.v1" },
    "command": { "const": "review_context" },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/context_result" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "review_context"],
          "properties": {
            "files": { "type": "array", "items": { "type": "string" } },
            "review_context": { "type": "object", "additionalProperties": true }
          }
        }
      ]
    }
  },
  "$defs": {
    "repo_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id"],
      "properties": {
        "repo_id": { "type": "string" },
        "repo_fingerprint": { "type": ["string", "null"] },
        "repo_root": { "type": ["string", "null"] },
        "remote_url": { "type": ["string", "null"] }
      }
    },
    "context_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "requested_nodes", "emitted_nodes", "requested_edges", "emitted_edges", "requested_files", "emitted_files", "requested_saved_sources", "emitted_saved_sources", "requested_content_assets", "emitted_content_assets", "requested_overviews", "emitted_overviews", "requested_bytes", "emitted_bytes", "requested_tokens", "emitted_tokens", "budget_hit", "duration_ms", "outcome"],
      "properties": {
        "intent": { "type": "string" },
        "requested_nodes": { "type": "integer" },
        "emitted_nodes": { "type": "integer" },
        "requested_edges": { "type": "integer" },
        "emitted_edges": { "type": "integer" },
        "requested_files": { "type": "integer" },
        "emitted_files": { "type": "integer" },
        "requested_saved_sources": { "type": "integer" },
        "emitted_saved_sources": { "type": "integer" },
        "requested_content_assets": { "type": "integer" },
        "emitted_content_assets": { "type": "integer" },
        "requested_overviews": { "type": "integer" },
        "emitted_overviews": { "type": "integer" },
        "requested_bytes": { "type": "integer" },
        "emitted_bytes": { "type": "integer" },
        "requested_tokens": { "type": "integer" },
        "emitted_tokens": { "type": "integer" },
        "budget_hit": { "type": "boolean" },
        "budget_name": { "type": ["string", "null"] },
        "duration_ms": { "type": "integer" },
        "outcome": { "type": "string", "enum": ["ok", "empty", "ambiguous", "budget_exhausted", "error"] }
      }
    },
    "context_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "request",
        "nodes",
        "edges",
        "files",
        "truncation",
        "ambiguity",
        "saved_context_sources",
        "budget_status",
        "budget_hit",
        "budget_name",
        "budget_limit",
        "budget_observed",
        "partial",
        "safe_to_answer"
      ],
      "properties": {
        "request": { "type": "object", "additionalProperties": true },
        "nodes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "edges": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "files": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "truncation": { "type": "object", "additionalProperties": true },
        "seed_budgets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "traversal_budget": { "type": ["object", "null"], "additionalProperties": true },
        "ambiguity": { "type": ["object", "null"] },
        "workflow": { "type": ["object", "null"], "additionalProperties": true },
        "saved_context_sources": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "repo_provenance": { "$ref": "#/$defs/repo_provenance" },
        "telemetry": { "$ref": "#/$defs/context_telemetry" },
        "budget_status": { "type": "string" },
        "budget_hit": { "type": "boolean" },
        "budget_name": { "type": ["string", "null"] },
        "budget_limit": { "type": ["integer", "null"] },
        "budget_observed": { "type": ["integer", "null"] },
        "partial": { "type": "boolean" },
        "safe_to_answer": { "type": "boolean" },
        "context_ranking_evidence_legend": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
