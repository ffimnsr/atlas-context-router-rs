{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-context-router-rs/schemas/atlas_cli.v1/insights-infer-modules.schema.json",
  "title": "atlas_cli.v1 insights_infer_modules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "data"],
  "properties": {
    "schema_version": { "const": "atlas_cli.v1" },
    "command": { "const": "insights_infer_modules" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings", "modules", "atlas_provenance"],
      "properties": {
        "summary": { "type": "object", "additionalProperties": false, "required": ["total_findings", "generated_at"], "properties": { "total_findings": { "type": "integer", "minimum": 0 }, "highest_severity": { "type": ["string", "null"], "enum": ["info", "low", "medium", "high", null] }, "generated_at": { "type": "string" } } },
        "findings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "modules": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "atlas_provenance": { "type": "object", "additionalProperties": false, "required": ["indexed_file_count"], "properties": { "indexed_file_count": { "type": "integer", "minimum": 0 }, "last_indexed_at": { "type": ["string", "null"] } } },
        "atlas_freshness": { "type": ["object", "null"], "additionalProperties": true }
      }
    }
  }
}
