{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-context-router-rs/schemas/atlas_cli.v1/doctor.schema.json",
  "title": "atlas_cli.v1 doctor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "data"],
  "properties": {
    "schema_version": { "const": "atlas_cli.v1" },
    "command": { "const": "doctor" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error_code", "recovery_mode", "quarantine_path", "rebuild_result", "failure_reason", "message", "suggestions", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "error_code": { "type": "string" },
        "health_class": { "type": ["string", "null"] },
        "recovery_mode": { "type": "string" },
        "quarantine_path": { "type": ["string", "null"] },
        "rebuild_result": { "type": "string" },
        "failure_reason": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "suggestions": { "type": "array", "items": { "type": "string" } },
        "repo_provenance": { "$ref": "#/$defs/repo_provenance" },
        "execution_state": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "ok", "detail", "issue_code"],
            "properties": {
              "check": { "type": "string" },
              "ok": { "type": "boolean" },
              "detail": { "type": "string" },
              "issue_code": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repo_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "repo_fingerprint", "repo_root"],
      "properties": {
        "repo_id": { "type": "string" },
        "repo_fingerprint": { "type": "string" },
        "repo_root": { "type": "string" },
        "remote_url": { "type": ["string", "null"] }
      }
    }
  }
}
